@using IPC2_Proy02_202602_202407617.Models

@{
	ViewBag.Title = "Buscar libro";
}

<div class="container" style="margin-top:30px;">

	<h2>Buscar libro</h2>
	<hr />

	@using (Html.BeginForm("Buscar", "Catalogo", FormMethod.Post))
	{
		<div class="form-group">

			<label>ISBN</label>

			<input type="number"
				   name="isbn"
				   class="form-control"
				   required />

		</div>

		<br />

		<button type="submit"
				class="btn btn-primary">
			Buscar
		</button>
	}

	<br />

	@if (ViewBag.BusquedaRealizada == true)
	{
		Libro libro = ViewBag.Libro as Libro;

		if (libro != null)
		{
			<div class="panel panel-success">

				<div class="panel-heading">
					Libro encontrado
				</div>

				<div class="panel-body">

					<p><strong>ISBN:</strong> @libro.ISBN</p>

					<p><strong>Título:</strong> @libro.Titulo</p>

					<p><strong>Autor:</strong> @libro.Autor</p>

					<p><strong>Categoría:</strong> @libro.Categoria</p>

				</div>

			</div>
		}
		else
		{
			<div class="alert alert-danger">
				No se encontró un libro con ese ISBN.
			</div>
		}
	}

	<a href="@Url.Action("Index", "Catalogo")"
	   class="btn btn-default">
		Regresar
	</a>

</div>