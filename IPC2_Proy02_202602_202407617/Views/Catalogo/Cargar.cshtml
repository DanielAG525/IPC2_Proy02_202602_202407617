@{
	ViewBag.Title = "Cargar archivo";
}

<div class="container" style="margin-top:30px;">

	<h2>Cargar archivo XML</h2>
	<hr />

	@if (ViewBag.Mensaje != null)
	{
		<div class="alert alert-info">
			@ViewBag.Mensaje
		</div>
	}

	@using (Html.BeginForm("Cargar", "Catalogo",
		FormMethod.Post,
		new { enctype = "multipart/form-data" }))
	{
		<div class="form-group">
			<label>Seleccione un archivo XML</label>

			<input type="file"
				   name="archivo"
				   accept=".xml"
				   class="form-control" />
		</div>

		<br />

		<button type="submit"
				class="btn btn-primary">
			Cargar archivo
		</button>

		<a href="@Url.Action("Index", "Catalogo")"
		   class="btn btn-default">
			Regresar
		</a>
	}

</div>