@{
    ViewBag.Title = "Agregar categoría";
}

<div class="container" style="margin-top:30px;">

    <h2>Agregar categoría</h2>
    <hr />

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info">
            @ViewBag.Mensaje
        </div>
    }

    <div class="panel panel-primary">

        <div class="panel-heading">
            Nueva categoría
        </div>

        <div class="panel-body">

            @using (Html.BeginForm(
                "AgregarCategoria",
                "Catalogo",
                FormMethod.Post))
            {
                <div class="form-group">

                    <label>
                        Nombre de la categoría
                    </label>

                    <input type="text"
                           name="nombre"
                           class="form-control"
                           required />

                </div>

                <div class="form-group">

                    <label>
                        Categoría padre
                    </label>

                    <input type="text"
                           name="padre"
                           class="form-control"
                           placeholder="Ejemplo: Ciencia" />

                    <p class="help-block">
                        Deje este campo vacío si la categoría
                        no tendrá una categoría padre.
                    </p>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Agregar categoría
                </button>
            }

        </div>

    </div>

    <a href="@Url.Action("Categorias", "Catalogo")"
       class="btn btn-success">
        Ver categorías
    </a>

    <a href="@Url.Action("Index", "Catalogo")"
       class="btn btn-default">
        Regresar
    </a>

</div>