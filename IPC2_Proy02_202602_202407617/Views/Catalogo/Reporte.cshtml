@{
	ViewBag.Title = "Reporte de estructuras";
}

<div class="container" style="margin-top:30px;">

	<h2>Reporte de estructuras</h2>
	<hr />

	<div class="panel panel-primary">

		<div class="panel-heading">
			Árbol de libros
		</div>

		<div class="panel-body">

			@if (ViewBag.GraficaLibros != null)
			{
				<img src="@ViewBag.GraficaLibros"
					 class="img-responsive"
					 alt="Árbol de libros" />
			}
			else
			{
				<p>
					No se ha generado la gráfica de libros.
				</p>
			}

		</div>

	</div>

	<div class="panel panel-success">

		<div class="panel-heading">
			Árbol de categorías
		</div>

		<div class="panel-body">

			@if (ViewBag.GraficaCategorias != null)
			{
				<img src="@ViewBag.GraficaCategorias"
					 class="img-responsive"
					 alt="Árbol de categorías" />
			}
			else
			{
				<p>
					No se ha generado la gráfica de categorías.
				</p>
			}

		</div>

	</div>

	<a href="@Url.Action("Index", "Catalogo")"
	   class="btn btn-default">
		Regresar
	</a>

</div>