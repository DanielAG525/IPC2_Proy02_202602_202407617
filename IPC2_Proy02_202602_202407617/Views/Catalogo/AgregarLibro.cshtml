@{
    ViewBag.Title = "Agregar libro";
}

<div class="container" style="margin-top:30px;">

    <h2>Agregar libro</h2>
    <hr />

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info">
            @ViewBag.Mensaje
        </div>
    }

    <div class="panel panel-primary">

        <div class="panel-heading">
            Nuevo libro
        </div>

        <div class="panel-body">

            @using (Html.BeginForm(
                "AgregarLibro",
                "Catalogo",
                FormMethod.Post))
            {
                <div class="form-group">
                    <label>ISBN</label>

                    <input type="number"
                           name="isbn"
                           class="form-control"
                           min="1"
                           required />
                </div>

                <div class="form-group">
                    <label>Título</label>

                    <input type="text"
                           name="titulo"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Autor</label>

                    <input type="text"
                           name="autor"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    <label>Categoría</label>

                    <input type="text"
                           name="categoria"
                           class="form-control"
                           placeholder="Ejemplo: Fisica"
                           required />

                    <p class="help-block">
                        La categoría debe existir previamente.
                    </p>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Agregar libro
                </button>
            }

        </div>

    </div>

    <a href="@Url.Action("Libros", "Catalogo")"
       class="btn btn-success">
        Ver libros
    </a>

    <a href="@Url.Action("Index", "Catalogo")"
       class="btn btn-default">
        Regresar
    </a>

</div>